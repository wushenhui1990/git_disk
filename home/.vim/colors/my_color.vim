" Customize the highlight groups for vimdiff
highlight DiffAdd    term=bold ctermfg=DarkGreen guifg=#00FF00 ctermbg=Blue guibg=#1e1e1e
highlight DiffChange term=bold ctermfg=yellow guifg=#FFFF00 ctermbg=Blue guibg=#1e1e1e
highlight DiffDelete term=bold ctermfg=red guifg=#FF0000 ctermbg=Blue guibg=#1e1e1e
highlight DiffText   term=bold ctermfg=red guifg=#0000FF ctermbg=Blue guibg=#1e1e1e
